#!name=KK键盘无限变声
#!desc=解锁KK键盘无限变声功能数据限制
#!author=Gemini
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Keyboard.png
#!date=2026-05-27

[Script]
# 调用 iCloud 中的 JS 脚本修改响应体。请确保 script-path 的路径与你实际保存在 iCloud 中的位置一致。
http-response ^https?:\/\/kk\.weshine\.im\/v1\.0\/text2voice\/(checkCount|consumeCount|createTtsAudio) script-path=kk_voice.js, requires-body=true, timeout=10, tag=KK键盘变声解锁

[MitM]
# 信任域名以解密 HTTPS 流量
hostname = kk.weshine.im